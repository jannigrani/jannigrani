rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Security rules for city reports
    match /reports/{reportId} {
      
      // Anyone can read reports marked as public
      // Logged-in users can read their own reports
      allow read: if resource.data.status == 'public' || 
                     (request.auth != null && resource.data.userId == request.auth.uid);

      // Only logged-in users can submit a new report
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid;

      // Logged-in users can only edit their own reports
      allow update: if request.auth != null && 
                       resource.data.userId == request.auth.uid;

      // Logged-in users can only delete their own reports
      allow delete: if request.auth != null && 
                       resource.data.userId == request.auth.uid;
    }

    // Lock down all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}