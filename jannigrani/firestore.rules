rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Security rules for city reports
    match /reports/{reportId} {
      // Allow everyone to read reports and submit new ones
      allow read, create: if true;
      // Allow logged-in users to update or delete reports
      allow update, delete: if request.auth != null;
    }

    // Security rules for user profile data tables (locked down to owner)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Lock down all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}